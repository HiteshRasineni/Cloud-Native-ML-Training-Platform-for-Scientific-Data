# PostgreSQL
POSTGRES_USER=mlplatform
POSTGRES_PASSWORD=mlplatform
POSTGRES_DB=mlplatform
DATABASE_URL=postgresql+psycopg2://mlplatform:mlplatform@postgres:5432/mlplatform

# Redis
REDIS_URL=redis://redis:6379/0
EXPERIMENT_QUEUE=experiments:queued

# MinIO object storage
MINIO_ROOT_USER=mlplatform
MINIO_ROOT_PASSWORD=mlplatform-secret
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=mlplatform

# MLflow (SQLite backend store; artifacts in MinIO)
MLFLOW_TRACKING_URI=http://mlflow:5000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Scheduler
WORKER_IMAGE=cloud-ml-platform-worker:latest
SCHEDULER_POLL_INTERVAL=2
