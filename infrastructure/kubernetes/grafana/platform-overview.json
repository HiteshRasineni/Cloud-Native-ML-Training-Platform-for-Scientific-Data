{
  "uid": "platform-overview",
  "title": "Platform Overview",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "type": "piechart", "title": "API Responses by Status", "targets": [{"expr": "sum by (status) (rate(http_requests_total[5m]))", "legendFormat": "{{status}}"}]},
    {"id": 2, "type": "timeseries", "title": "API Request Rate", "targets": [{"expr": "sum(rate(http_requests_total[5m]))", "legendFormat": "requests/sec"}]},
    {"id": 3, "type": "stat", "title": "API Error Rate", "targets": [{"expr": "sum(rate(http_errors_total[5m]))", "legendFormat": "errors/sec"}]},
    {"id": 4, "type": "timeseries", "title": "p95 API Latency", "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 5, "type": "timeseries", "title": "HTTP Request Rate by Path", "targets": [{"expr": "sum by (handler) (rate(http_requests_total[5m]))", "legendFormat": "{{handler}}"}]}
  ]
}
